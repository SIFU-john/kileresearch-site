# Copy to .env for local overrides. Never commit .env.
# Canonical site origin (placeholder until a domain is approved)
SITE_URL=https://kile-research.example
# Address used for the mailto fallback when no form provider is configured (STUB)
PUBLIC_CONTACT_EMAIL=hello@example.com
# Forms adapter: "none" (default, mailto fallback) or "http-post" (JSON POST to the endpoints below)
PUBLIC_FORMS_PROVIDER=none
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_NEWSLETTER_ENDPOINT=
