# Copy to .env for local overrides. Never commit .env. In Cloudflare Pages, set these under
# Settings > Variables and Secrets (per environment). Anything unset is switched off.

# Canonical origin: canonical, Open Graph, RSS, sitemap, JSON-LD and security.txt all derive from it.
SITE_URL=https://kileresearch.ai

# STUB until email is set up on the domain (KILA-43, email layout decision).
PUBLIC_CONTACT_EMAIL=hello@kileresearch.ai

# Newsletter (Buttondown). Unset = newsletter panels show a mailto fallback.
PUBLIC_BUTTONDOWN_USERNAME=
# Copy the host from Buttondown's generated embed code (older embeds use https://buttondown.email).
PUBLIC_BUTTONDOWN_HOST=https://buttondown.com

# Enquiry form: pages-function (default, our /api/contact Function) | formspree | none (mailto only)
PUBLIC_CONTACT_PROVIDER=pages-function
PUBLIC_FORMSPREE_FORM_ID=
# Turnstile site key (public). The matching TURNSTILE_SECRET is a Pages *secret*, never PUBLIC_*.
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics site token (public). Unset = no analytics script at all.
PUBLIC_CF_ANALYTICS_TOKEN=

# CSP header mode: enforce | report-only (use report-only on the Preview environment first).
CSP_MODE=enforce

# Optional: Medium profile URL, shown as "Also on Medium" in the footer.
PUBLIC_MEDIUM_PROFILE=

# --- Server-side only (Pages Function). Set in the dashboard, not here. ---
# TURNSTILE_SECRET   (secret)  Turnstile secret key
# ALLOWED_ORIGINS    (text)    https://kileresearch.ai,https://*.<project>.pages.dev
# CONTACT_FROM       (text)    sender on the Email Routing zone, e.g. forms@kileresearch.ai
# CONTACT_TO         (text)    verified Email Routing destination address
# CONTACT_EMAIL      (binding) send_email binding
