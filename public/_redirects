# Cloudflare Pages redirects. www -> apex is a Cloudflare Redirect Rule, not this file
# (docs/cloudflare-pages.md). Trailing slashes are handled by Pages automatically.
/feed /rss.xml 301
/feed/ /rss.xml 301

# Preserve the former article, tag and series URLs.
/research/tags/* /tutorials/tags/:splat 301
/research/series/* /tutorials/series/:splat 301
/research/:slug /tutorials/:slug/ 301
/research/:slug/ /tutorials/:slug/ 301
