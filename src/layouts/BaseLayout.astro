---
import '../styles/global.css';
import '../styles/editorial.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { fonts } from '../config/fonts';
import { integrations } from '../config/integrations';

interface Props {
  title: string;
  description?: string | undefined;
  /** Root-relative or absolute image for social cards (1200x630). */
  ogImage?: string | undefined;
  ogImageAlt?: string | undefined;
  ogType?: 'website' | 'article';
  canonical?: string | undefined;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: Date | undefined;
  modifiedTime?: Date | undefined;
  /** Article pages: preload the reading serif and show the reading-progress bar. */
  reading?: boolean;
  /** Above-the-fold image to preload ahead of fonts (the page's LCP element). */
  lcpImage?: string | undefined;
  /** Pages with the enquiry form: load Turnstile (only if a site key is configured). */
  enquiry?: boolean;
}

const {
  title, description = site.description, ogImage = '/og/default.png', ogType = 'website', noindex = false,
  jsonLd, publishedTime, modifiedTime, reading = false, enquiry = false, lcpImage,
} = Astro.props;
const canonical = new URL(Astro.props.canonical ?? Astro.url.pathname, Astro.site).href;
const fullTitle = title === site.name ? `${site.name}: ${site.tagline}` : `${title} · ${site.name}`;
const image = new URL(ogImage, Astro.site).href;
const imageAlt = Astro.props.ogImageAlt ?? `${title} — ${site.name}`;
// JSON-LD is a data block (not executed), so CSP script-src does not apply. Escape "<" so
// no value can close the tag.
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
const { analyticsToken, turnstileSiteKey } = integrations;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0E0E" media="(prefers-color-scheme: dark)" />
    <!-- Same-origin, blocking and tiny: applies a stored theme choice before first paint. -->
    <script is:inline src="/theme.js"></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {lcpImage && <link rel="preload" href={lcpImage} as="image" fetchpriority="high" />}
    <link rel="preload" href={fonts.sans} as="font" type="font/woff2" crossorigin />
    <!-- The serif sets every headline now, so preload it on all pages. -->
    <link rel="preload" href={fonts.serif} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_GB" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={imageAlt} />
    {ld && <script is:inline type="application/ld+json" set:html={ld} />}
    {analyticsToken && <script is:inline src="/js/analytics.js" data-cf-token={analyticsToken} defer></script>}
    {enquiry && turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header progress={reading} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
