---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you were looking for doesn't exist." noindex>
  <div class="container section stack">
    <p class="overline">404</p>
    <h1>We couldn't find that page</h1>
    <p class="lead">It may have moved when we left Medium. Try the research index or search.</p>
    <p class="actions"><a class="btn btn-primary" href="/research/">Browse research</a> <a class="btn btn-secondary" href="/">Go home</a></p>
  </div>
</BaseLayout>
<style>.actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }</style>
