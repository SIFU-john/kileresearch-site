---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleRow from '../../../components/ArticleRow.astro';
import FilterNav from '../../../components/FilterNav.astro';
import { getArticles, seriesUrl, slugify, type Article } from '../../../lib/content';

export async function getStaticPaths() {
  const all = await getArticles();
  const names = [...new Set(all.flatMap((a) => (a.data.series ? [a.data.series.name] : [])))];
  return names.map((name) => ({
    params: { series: slugify(name) },
    props: { all, name, items: all.filter((a) => a.data.series?.name === name).sort((a, b) => a.data.series!.part - b.data.series!.part) },
  }));
}
interface Props { all: Article[]; name: string; items: Article[] }
const { all, name, items } = Astro.props;
---
<BaseLayout title={name} description={`Every part of the ${name} series from Kile Research, in reading order, with runnable code for each step.`}>
  <div class="container section">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/tutorials/">Tutorials</a> / Series</nav>
    <h1>{name}</h1>
    <p class="lead">{items.length} parts, in reading order.</p>
    <FilterNav articles={all} current={seriesUrl(name)} />
    <ol class="list-reset list">{items.map((a) => <li><ArticleRow article={a} headingLevel="h2" /></li>)}</ol>
  </div>
</BaseLayout>
<style>
  .crumb { font-size: var(--text-sm); color: var(--color-text-muted); }
  .crumb a { color: inherit; }
  h1 { margin-block: var(--space-3); }
  .list { display: grid; gap: var(--space-10); margin-top: var(--space-10); max-width: 60rem; }
</style>
