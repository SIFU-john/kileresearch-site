---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
// STUB: draft statement. Update the conformance status after Gate A (KILA-42) has been run on the build.
---
<BaseLayout title="Accessibility statement" description="How Kile Research makes its site usable for everyone, and how to tell us about a problem.">
  <div class="container section">
    <div class="page-prose">
      <h1>Accessibility statement</h1>
      <p>We want everyone to be able to read our research and get in touch, including people who use a keyboard, a screen reader, zoom or high-contrast settings.</p>
      <h2>What we aim for</h2>
      <ul>
        <li>WCAG 2.2 level AA across the site.</li>
        <li>Everything works with a keyboard, with a visible focus indicator.</li>
        <li>Light and dark themes, both contrast-checked, and no essential motion.</li>
        <li>Pages, forms and code examples work without JavaScript.</li>
      </ul>
      <h2>Tell us about a problem</h2>
      <p>If something doesn't work for you, email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> and tell us the page and what happened. We'll reply and fix it.</p>
    </div>
  </div>
</BaseLayout>
