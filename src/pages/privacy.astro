---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
// STUB: plain-language draft. Needs review by Head of Security & Compliance (and legal)
// before launch, and must be updated when a forms/newsletter provider and host are chosen.
---
<BaseLayout title="Privacy notice" description="How Kile Research handles your data: no cookies, no trackers, and only the details you choose to send us.">
  <div class="container section">
    <div class="prose">
      <p class="overline">Privacy</p>
      <h1>Privacy notice</h1>
      <p class="alert alert-info"><span>Draft: this notice is pending review and will be finalised before the site launches.</span></p>
      <h2>The short version</h2>
      <ul>
        <li>We don't use cookies, analytics, advertising or tracking scripts.</li>
        <li>We don't load fonts, scripts or images from third parties, so visiting this site doesn't tell anyone else you were here.</li>
        <li>We only receive personal data you choose to send us, through the contact form, newsletter sign-up or email.</li>
      </ul>
      <h2>What we collect and why</h2>
      <p><strong>Contact form and email:</strong> your name, email address, company (optional) and message. We use these only to reply to you, and keep them for up to 24 months unless you ask us to delete them sooner.</p>
      <p><strong>Newsletter:</strong> your email address, used only to send you new articles. Every email has an unsubscribe link.</p>
      <p><strong>Server logs:</strong> our hosting provider keeps standard request logs (such as IP address, page and time) for security and troubleshooting, for a limited period.</p>
      <h2>Who processes it</h2>
      <p>[Placeholder: hosting provider and form/newsletter provider, with links to their privacy policies, once chosen.]</p>
      <h2>Your rights</h2>
      <p>You can ask to see, correct or delete the personal data we hold about you, or object to how we use it. Email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>. You also have the right to complain to your local data protection authority.</p>
      <p class="muted">Last updated: [date on launch].</p>
    </div>
  </div>
</BaseLayout>
<style>
  h1 { margin-block: var(--space-3) var(--space-4); }
  .alert span { color: var(--color-text); }
</style>
