---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ConsultingCta from '../components/ConsultingCta.astro';
import NewsletterForm from '../components/forms/NewsletterForm.astro';
import { site } from '../config/site';
import { getArticles, articleUrl, seriesUrl } from '../lib/content';

const articles = await getArticles();
const [featured, ...rest] = articles;
const latest = rest.slice(0, 3);
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: new URL('/', Astro.site).href, sameAs: [site.codeRepo] },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: new URL('/', Astro.site).href },
];
---
<BaseLayout title={site.name} jsonLd={jsonLd}>
  <section class="hero" data-surface="ink">
    <div class="container hero-inner">
      <p class="overline">Kile Research</p>
      <h1>Learn how AI really runs. <span class="accent">Measure it yourself.</span></h1>
      <p class="lead">Hands-on, reproducible guides to AI and LLM inference for developers, IT and cloud teams. One idea per article, real numbers from a real test rig, and all the code in the open.</p>
      <p class="actions">
        {featured && <a class="btn btn-primary" href={articleUrl(featured)}>Read the latest</a>}
        <a class="btn btn-secondary" href={seriesUrl("Beginner's Guide to Inference")}>Start the series</a>
      </p>
      <div class="signal" aria-hidden="true"></div>
    </div>
  </section>

  {featured && (
    <section class="container section" aria-labelledby="latest-title">
      <div class="section-head">
        <h2 id="latest-title">Latest research</h2>
        <a href="/research/">All research →</a>
      </div>
      <div class="featured">
        <ArticleCard article={featured} />
      </div>
      {latest.length > 0 && <div class="grid more">{latest.map((a) => <ArticleCard article={a} />)}</div>}
    </section>
  )}

  <section class="container principles" aria-labelledby="how-title">
    <h2 id="how-title" class="visually-hidden">How we write</h2>
    <ul class="grid">
      <li class="card"><h3>Measured, not claimed</h3><p class="muted">Every command and number was run on our test rig, with the hardware stated. Anything untested is labelled.</p></li>
      <li class="card"><h3>Reproducible</h3><p class="muted">Each article links to its script and raw results, so you can rerun it and compare.</p></li>
      <li class="card"><h3>Plain language</h3><p class="muted">Jargon is defined the first time it appears. Facts, documentation and our opinions are kept apart.</p></li>
    </ul>
  </section>

  <section class="container section">
    <ConsultingCta />
  </section>
  <section class="container nl"><NewsletterForm /></section>
</BaseLayout>

<style>
  .hero { padding-block: var(--space-section); position: relative; overflow: hidden; }
  .hero-inner { position: relative; display: grid; gap: var(--space-6); }
  .hero h1 { font-size: var(--text-5xl); max-width: 18ch; }
  .accent { color: var(--color-accent); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .signal {
    height: 2px; max-width: 32rem; margin-top: var(--space-8);
    background: linear-gradient(90deg, var(--signal-400) 0 60%, transparent 60% 66%, var(--signal-400) 66% 100%);
    transform-origin: left; animation: draw var(--duration-reveal) var(--ease-enter) both 200ms;
  }
  @keyframes draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); margin-bottom: var(--space-6); flex-wrap: wrap; }
  .section-head h2 { font-size: var(--text-3xl); }
  .featured :global(.card) { padding: var(--space-8); }
  .featured :global(.title) { font-size: var(--text-3xl); }
  .more { margin-top: var(--space-6); }
  .principles ul { list-style: none; padding: 0; margin: 0; }
  .principles h3 { font-size: var(--text-xl); }
  .nl { margin-top: var(--space-section); }
</style>
