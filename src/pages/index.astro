---
// Home, editorial layout (KILA-41 redesign; reference: Noter). Featured story, a row of cover
// tiles, then the reading list with a sidebar (who we are, newsletter, consulting).
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArticleRow from '../components/ArticleRow.astro';
import Cover from '../components/Cover.astro';
import NewsletterForm from '../components/forms/NewsletterForm.astro';
import { site } from '../config/site';
import { services } from '../config/services';
import { coverUrl } from '../lib/cover';
import { getArticles, articleUrl, formatDate, levelLabel, readingMinutes, seriesUrl } from '../lib/content';

const articles = await getArticles();
const [featured, ...rest] = articles;
const tiles = rest.slice(0, 3);
const seriesName = articles.find((a) => a.data.series)?.data.series?.name;
const seriesParts = seriesName
  ? articles.filter((a) => a.data.series?.name === seriesName).sort((a, b) => a.data.series!.part - b.data.series!.part)
  : articles;
const origin = new URL('/', Astro.site).href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: origin, logo: new URL('/favicon.svg', Astro.site).href, sameAs: [site.codeRepo] },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: origin, inLanguage: 'en-GB' },
];
---
<BaseLayout title={site.name} jsonLd={jsonLd} footerNewsletter={false} lcpImage={featured && !featured.data.cover ? coverUrl(featured.id) : undefined}>
  <!-- Intro line (Gate A R5). Placeholder wording: Chris to confirm the final copy. -->
  <header class="container intro">
    <h1>Run, measure and understand AI models <em>yourself.</em></h1>
    <p>Plain-language, reproducible research on LLM inference, with code you can run. <a href="/about/">About us</a></p>
  </header>

  {featured && (
    <section class="container feature-wrap" aria-labelledby="featured-title">
      <article class="feature">
        <div class="media"><Cover article={featured} eager sizes="(min-width: 64rem) 50vw, 100vw" /></div>
        <div class="feature-text">
          <p class="overline">Latest{featured.data.series && ` · ${featured.data.series.name} · Part ${featured.data.series.part}`}</p>
          <h2 id="featured-title"><a class="stretched" href={articleUrl(featured)}>{featured.data.title}</a></h2>
          <p class="desc">{featured.data.description}</p>
          <p class="meta-line">
            <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time>
            <span aria-hidden="true"> · </span>{readingMinutes(featured)} min read{featured.data.level && <> · {levelLabel(featured.data.level)}</>}
          </p>
        </div>
      </article>
    </section>
  )}

  {tiles.length > 0 && (
    <section class="container" aria-labelledby="more-title">
      <h2 id="more-title" class="visually-hidden">More research</h2>
      <ul class="list-reset tiles">{tiles.map((a) => <li><ArticleCard article={a} /></li>)}</ul>
    </section>
  )}

  <div class="container split">
    <section class="reading" aria-labelledby="start-title">
      <div class="section-label">
        <h2 id="start-title" class="overline">Start here{seriesName && `: ${seriesName}`}</h2>
        <a class="text-more" href={seriesName ? seriesUrl(seriesName) : '/research/'}>View series<span class="visually-hidden">: {seriesName}</span></a>
      </div>
      <ol class="list-reset posts">{seriesParts.map((a) => <li><ArticleRow article={a} showTags={false} /></li>)}</ol>
      <a class="btn btn-secondary btn-block" href="/research/">All research</a>
    </section>

    <aside class="sidebar" aria-label="About Kile Research">
      <section class="panel panel-subtle welcome" aria-labelledby="welcome-title">
        <h2 id="welcome-title">Welcome to Kile Research</h2>
        <div class="who">
          <span class="avatar" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="30" height="30" focusable="false"><path d="M7 20 H14 M18 20 L22 13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path><circle cx="24" cy="10.5" r="2.25" fill="currentColor"></circle></svg>
          </span>
          <p class="who-name">Run, measure and understand AI models yourself.</p>
        </div>
        <p>Plain-language, reproducible write-ups on LLM inference for beginner and intermediate readers. Every article links to code you can run.</p>
        <a class="text-more" href="/about/">Read more<span class="visually-hidden"> about Kile Research</span></a>
      </section>

      <NewsletterForm idPrefix="home-nl" />

      <section class="promo" aria-labelledby="promo-title">
        <div class="media"><Cover slug="consulting" sizes="(min-width: 64rem) 25vw, 100vw" /></div>
        <div class="glass">
          <p class="overline">For small businesses</p>
          <h2 id="promo-title">Thinking about AI for your business?</h2>
          <ul class="list-reset svc">{services.map((s) => <li><a href={`/consulting/#${s.id}`}>{s.name}</a></li>)}</ul>
          <a class="btn btn-primary btn-block" href="/consulting/">See how we can help</a>
        </div>
      </section>
    </aside>
  </div>
</BaseLayout>

<style>
  .intro { display: grid; gap: var(--space-3); padding-block: var(--space-10) var(--space-2); }
  .intro h1 { font-size: clamp(1.875rem, 1.3rem + 2.4vw, 3.25rem); line-height: 1.1; max-width: 24ch; }
  .intro em { font-style: italic; font-weight: 500; }
  .intro p { color: var(--color-text-muted); font-size: var(--text-lg); max-width: 40rem; }
  .intro a { color: var(--color-text-strong); }
  .feature-wrap { padding-top: var(--space-8); }
  .feature { position: relative; display: grid; gap: var(--space-6) var(--space-10); align-items: center; }
  .feature .media { aspect-ratio: 13 / 9; }
  @media (min-width: 56rem) { .feature { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .feature-text { display: grid; gap: var(--space-4); max-width: 36rem; }
  .feature h2 { font-size: clamp(2rem, 1.4rem + 2.2vw, 3rem); line-height: 1.12; }
  .feature .desc { font-size: var(--text-lg); color: var(--color-text-muted); display: -webkit-box; -webkit-line-clamp: 4; line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .meta-line { font-size: var(--text-sm); color: var(--color-text-muted); }

  .tiles { display: grid; gap: var(--space-6); margin-top: var(--space-10); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }

  .split { display: grid; gap: var(--space-12) var(--space-10); margin-top: var(--space-16); align-items: start; }
  @media (min-width: 64rem) { .split { grid-template-columns: minmax(0, 1fr) minmax(0, 24rem); } }
  .section-label { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); margin-bottom: var(--space-6); }
  .section-label .overline { font-family: var(--font-mono); font-size: 0.875rem; }
  .text-more {
    display: inline-flex; align-items: center; min-height: var(--target-min); font-size: 0.875rem; font-weight: var(--weight-semibold);
    letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-text-strong); text-decoration: none; white-space: nowrap;
  }
  .text-more:hover { text-decoration: underline; }
  .posts { display: grid; gap: var(--space-8); margin-bottom: var(--space-10); }

  .sidebar { display: grid; gap: var(--space-6); }
  @media (min-width: 64rem) { .sidebar { position: sticky; top: calc(var(--header-height) + var(--space-6)); } }
  .welcome { padding: var(--space-8) var(--space-6); }
  .welcome h2 { font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: var(--tracking-label); text-transform: uppercase; font-weight: 400; }
  .who { display: flex; align-items: center; gap: var(--space-4); }
  .avatar { flex: none; display: grid; place-items: center; width: 4rem; height: 4rem; border-radius: 50%; background: var(--color-accent); color: var(--color-on-accent); }
  .who-name { font-family: var(--font-serif); font-style: italic; font-size: 1.25rem; line-height: 1.3; color: var(--color-text-strong); }

  .promo { position: relative; border-radius: var(--radius-card); overflow: hidden; isolation: isolate; padding: var(--space-4); min-height: 26rem; display: flex; align-items: flex-end; }
  .promo .media { position: absolute; inset: 0; z-index: -1; border-radius: 0; }
  .promo .glass { width: 100%; padding: var(--space-6); background: var(--glass); color: var(--glass-text); border-radius: var(--radius-inner); display: grid; gap: var(--space-3); }
  @supports (backdrop-filter: blur(1px)) { .promo .glass { backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); } }
  .promo h2 { font-size: 1.5rem; line-height: 1.2; color: var(--glass-text); }
  .promo .overline { color: var(--glass-text); }
  .svc a { display: inline-flex; align-items: center; min-height: var(--target-min); color: var(--glass-text); }
</style>
