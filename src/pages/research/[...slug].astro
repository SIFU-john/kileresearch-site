---
// Article page (KILA-42 doc 2 §1 anatomy).
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import Reproduce from '../../components/Reproduce.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CtaZone from '../../components/CtaZone.astro';
import { authors } from '../../config/authors';
import { site, repoUrl } from '../../config/site';
import { getArticles, articleUrl, formatDate, levelLabel, readingMinutes, relatedArticles, seriesUrl, tagLabel, tagUrl, type Article } from '../../lib/content';

export async function getStaticPaths() {
  const all = await getArticles();
  return all.map((article) => ({ params: { slug: article.id }, props: { article, all } }));
}

interface Props { article: Article; all: Article[] }
const { article, all } = Astro.props;
const { Content, headings } = await render(article);
const d = article.data;
const minutes = readingMinutes(article);
const related = relatedArticles(article, all);
const inSeries = d.series ? all.filter((a) => a.data.series?.name === d.series!.name).sort((a, b) => a.data.series!.part - b.data.series!.part) : [];
const idx = inSeries.findIndex((a) => a.id === article.id);
const prev = idx > 0 ? inSeries[idx - 1] : undefined;
const next = idx >= 0 && idx < inSeries.length - 1 ? inSeries[idx + 1] : undefined;
const url = new URL(articleUrl(article), Astro.site).href;
const ogImage = d.ogImage?.src ?? `/og/${article.id}.png`;
const author = authors[d.author];
const hasToc = headings.filter((h) => h.depth === 2).length >= 3;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  author: { '@type': 'Organization', name: author.name, url: new URL('/about/', Astro.site).href },
  publisher: { '@type': 'Organization', name: site.name, url: new URL('/', Astro.site).href, logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).href } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': d.canonical ?? url },
  url: d.canonical ?? url,
  image: new URL(ogImage, Astro.site).href,
  keywords: d.tags.join(', '),
  wordCount: article.body?.split(/\s+/).length,
  inLanguage: 'en-GB',
  ...(d.level && { proficiencyLevel: levelLabel(d.level) }),
  ...(d.series && { isPartOf: { '@type': 'CreativeWorkSeries', name: d.series.name, url: new URL(seriesUrl(d.series.name), Astro.site).href } }),
  ...(d.repoPath && { codeRepository: repoUrl(d.repoPath) }),
  ...(d.mediumUrl && { sameAs: [d.mediumUrl] }),
};
---
<BaseLayout
  title={d.title}
  description={d.description}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={`${d.title} — ${site.name}`}
  canonical={d.canonical}
  noindex={d.draft}
  jsonLd={jsonLd}
  publishedTime={d.date}
  modifiedTime={d.updated}
  reading
>
  <div class="article-shell">
    <article aria-labelledby="article-title">
      <header class="article-head read-grid">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/research/">Research</a></li>
            {d.series && <li><a href={seriesUrl(d.series.name)}>{d.series.name}</a></li>}
          </ol>
          {hasToc && <a class="jump-toc" href="#contents">Jump to contents</a>}
        </nav>
        <div>
          {d.series && <p class="overline">Series · Part {d.series.part} of {inSeries.length}</p>}
          <h1 id="article-title">{d.title}</h1>
          <p class="lede">{d.description}</p>
          <p class="meta">
            <span>{author.name}</span>
            <span aria-hidden="true">·</span>
            <span><span class="visually-hidden">Published </span><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></span>
            {d.updated && <><span aria-hidden="true">·</span><span>Updated <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time></span></>}
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
            {d.level && <><span aria-hidden="true">·</span><span>Level: {levelLabel(d.level)}</span></>}
            {d.mediumUrl && <><span aria-hidden="true">·</span><a href={d.mediumUrl}>Also on Medium<span class="visually-hidden"> (opens external site)</span></a></>}
          </p>
        </div>
        {d.repoPath && <Reproduce repoPath={d.repoPath} variant="strip" />}
        <Toc headings={headings} variant="inline" />
      </header>

      <div class="prose read-grid" data-pagefind-body>
        <Content />
      </div>

      <footer class="article-end read-grid">
        {d.repoPath && <Reproduce repoPath={d.repoPath} variant="card" tested={d.tested} />}
        {(prev || next) && (
          <nav class="series-nav" aria-label="More in this series">
            {prev && <a href={articleUrl(prev)} rel="prev"><span class="overline">← Previous part</span><span>{prev.data.title}</span></a>}
            {next && <a class="next" href={articleUrl(next)} rel="next"><span class="overline">Next part →</span><span>{next.data.title}</span></a>}
          </nav>
        )}
        <div class="tags-row">
          <h2>Topics</h2>
          <ul class="tags">{d.tags.map((t) => <li><a class="tag" href={tagUrl(t)}>#{tagLabel(t)}</a></li>)}</ul>
        </div>
        <AuthorBox id={d.author} />
      </footer>
    </article>
    {hasToc && <div class="toc-rail no-print"><Toc headings={headings} variant="rail" /></div>}
  </div>

  <CtaZone tags={d.tags} />

  {related.length > 0 && (
    <section class="container related" aria-labelledby="related-title">
      <h2 id="related-title">Related research</h2>
      <div class="grid">{related.map((a) => <ArticleCard article={a} />)}</div>
    </section>
  )}
</BaseLayout>

<script>
  import '../../lib/article-enhance';
</script>
