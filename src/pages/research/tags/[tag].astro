---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleRow from '../../../components/ArticleRow.astro';
import FilterNav from '../../../components/FilterNav.astro';
import { getArticles, tagLabel, tagUrl, type Article } from '../../../lib/content';

export async function getStaticPaths() {
  const all = await getArticles();
  const tags = [...new Set(all.flatMap((a) => a.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { all, tag, items: all.filter((a) => a.data.tags.includes(tag)) } }));
}
interface Props { all: Article[]; tag: string; items: Article[] }
const { all, tag, items } = Astro.props;
---
<BaseLayout title={`Research on ${tagLabel(tag)}`} description={`Kile Research articles about ${tagLabel(tag)}: plain-language, reproducible write-ups on AI and LLM inference.`}>
  <div class="container section">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/research/">Research</a> / Topic</nav>
    <h1>{tagLabel(tag)}</h1>
    <p class="lead">{items.length} article{items.length === 1 ? '' : 's'}</p>
    <FilterNav articles={all} current={tagUrl(tag)} />
    <ol class="list-reset list" reversed>{items.map((a) => <li><ArticleRow article={a} headingLevel="h2" /></li>)}</ol>
  </div>
</BaseLayout>
<style>
  .crumb { font-size: var(--text-sm); color: var(--color-text-muted); }
  .crumb a { color: inherit; }
  h1 { text-transform: capitalize; margin-block: var(--space-3); font-size: clamp(2.5rem, 1.8rem + 3vw, 4rem); line-height: 1.05; }
  .list { display: grid; gap: var(--space-10); margin-top: var(--space-10); max-width: 60rem; }
</style>
