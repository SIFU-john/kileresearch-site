---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import Search from '../../components/Search.astro';
import FilterNav from '../../components/FilterNav.astro';
import { getArticles } from '../../lib/content';
const articles = await getArticles();
---
<BaseLayout title="Research" description="Every Kile Research article, newest first: plain-language, reproducible write-ups on AI and LLM inference, with code you can run.">
  <div class="container page">
    <header class="head">
      <p class="overline">{articles.length} articles · <a href="/rss.xml">RSS</a></p>
      <h1>Research</h1>
      <p class="lead">Plain-language, reproducible write-ups on running and measuring AI models. Newest first.</p>
    </header>
    <Search />
    <FilterNav articles={articles} />
    <div data-article-list>
      <h2 class="visually-hidden">Articles</h2>
      <ol class="list-reset list" reversed>{articles.map((a) => <li><ArticleRow article={a} /></li>)}</ol>
    </div>
  </div>
</BaseLayout>
<style>
  .page { padding-top: var(--space-12); }
  .head { display: grid; gap: var(--space-4); max-width: 46rem; margin-bottom: var(--space-8); }
  .head h1 { font-size: clamp(2.75rem, 1.8rem + 4vw, 4.5rem); line-height: 1; }
  .head .overline a { color: inherit; }
  .lead { font-size: var(--text-lg); max-width: 38rem; }
  .list { display: grid; gap: var(--space-10); margin-top: var(--space-10); max-width: 60rem; }
</style>
