---
// Client-side search over the Pagefind index (generated at build into /pagefind/).
// Uses the Pagefind JS API with our own markup, so styling follows the tokens and
// nothing injects inline styles.
---
<search class="search" aria-label="Search research">
  <form class="search-form" role="search" action="/research/" method="get">
    <label for="q" class="visually-hidden">Search articles</label>
    <input class="input" id="q" name="q" type="search" placeholder="Search articles, e.g. quantization" autocomplete="off" />
  </form>
  <p class="muted status" id="search-status" aria-live="polite"></p>
  <ol class="results" id="search-results"></ol>
</search>

<script>
  type Hit = { url: string; excerpt: string; meta: { title?: string } };
  type Pagefind = { search: (q: string) => Promise<{ results: { data: () => Promise<Hit> }[] } | null>; init?: () => Promise<void> };

  const input = document.getElementById('q') as HTMLInputElement | null;
  const list = document.getElementById('search-results');
  const status = document.getElementById('search-status');
  let pf: Pagefind | null = null;
  let seq = 0;

  async function load() {
    if (pf) return pf;
    const path = '/pagefind/pagefind.js';
    pf = (await import(/* @vite-ignore */ path)) as Pagefind;
    await pf.init?.();
    return pf;
  }

  // Pagefind excerpts contain only <mark> tags around matches; rebuild them as DOM nodes
  // instead of using innerHTML.
  function excerptNodes(excerpt: string) {
    const frag = document.createDocumentFragment();
    excerpt.split(/(<mark>.*?<\/mark>)/g).forEach((part) => {
      const m = /^<mark>(.*?)<\/mark>$/.exec(part);
      const text = (m ? m[1] : part)!.replace(/<[^>]*>/g, '');
      if (m) { const mark = document.createElement('mark'); mark.textContent = text; frag.append(mark); }
      else frag.append(text);
    });
    return frag;
  }

  async function run(q: string) {
    const mine = ++seq;
    if (!list || !status) return;
    if (q.trim().length < 2) { list.replaceChildren(); status.textContent = ''; return; }
    try {
      const engine = await load();
      const res = await engine.search(q);
      const hits = await Promise.all((res?.results ?? []).slice(0, 8).map((r) => r.data()));
      if (mine !== seq) return;
      list.replaceChildren(
        ...hits.map((h) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = h.url; a.textContent = h.meta.title ?? h.url;
          const p = document.createElement('p'); p.className = 'muted'; p.append(excerptNodes(h.excerpt));
          li.append(a, p);
          return li;
        }),
      );
      status.textContent = hits.length ? `${hits.length} result${hits.length === 1 ? '' : 's'}` : 'No matches. Try a different word.';
    } catch {
      status.textContent = 'Search is available on the built site (run npm run build).';
    }
  }

  if (input) {
    let t: ReturnType<typeof setTimeout>;
    input.addEventListener('input', () => { clearTimeout(t); t = setTimeout(() => run(input.value), 150); });
    input.form?.addEventListener('submit', (e) => { e.preventDefault(); run(input.value); });
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) { input.value = initial; run(initial); }
  }
</script>

<style>
  .search { display: grid; gap: var(--space-3); max-width: 40rem; }
  .status:empty { display: none; }
  .results { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-4); }
  .results :global(a) { font-weight: var(--weight-semibold); font-size: var(--text-lg); }
  .results :global(mark) { background: var(--color-bg-accent); color: var(--color-text-strong); padding: 0 0.1em; border-radius: 2px; }
</style>
