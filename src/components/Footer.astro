---
import { site, displayDomain } from '../config/site';
import { seriesUrl } from '../lib/content';
import Logo from './Logo.astro';
import NewsletterForm from './forms/NewsletterForm.astro';
interface Props { newsletter?: boolean }
const { newsletter = true } = Astro.props;
const year = new Date().getFullYear();
const domain = displayDomain(Astro.site);
---
<footer class="site-footer">
  <div class="container top">
    <a href="/" class="home" aria-label="Kile Research home"><Logo /></a>
    <ul class="list-reset social">
      <li>
        <a class="icon-link" href={site.codeRepo} aria-label="Research code on GitHub (opens external site)" title="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
        </a>
      </li>
      <li>
        <a class="icon-link" href="/rss.xml" aria-label="RSS feed" title="RSS feed">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 11a8 8 0 0 1 8 8M5 4a15 15 0 0 1 15 15"/><circle cx="6" cy="18" r="1.5" fill="currentColor" stroke="none"/></svg>
        </a>
      </li>
    </ul>
  </div>
  <div class="container cols">
    <nav aria-labelledby="f-research">
      <h2 id="f-research" class="visually-hidden">Research</h2>
      <ul class="list-reset">
        <li><a href="/research/">Research</a></li>
        <li><a href={seriesUrl("Beginner's Guide to Inference")}>Beginner series</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
        {site.mediumProfile && <li><a href={site.mediumProfile}>Also on Medium<span class="visually-hidden"> (opens external site)</span></a></li>}
      </ul>
    </nav>
    <nav aria-labelledby="f-company">
      <h2 id="f-company" class="visually-hidden">Company</h2>
      <ul class="list-reset">
        <li><a href="/consulting/">Consulting</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="f-trust">
      <h2 id="f-trust" class="visually-hidden">Trust</h2>
      <ul class="list-reset">
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/accessibility/">Accessibility</a></li>
        <li><button type="button" class="linklike" data-theme-reset hidden>Use system theme</button></li>
      </ul>
    </nav>
    {newsletter && <div class="nl"><NewsletterForm idPrefix="footer-nl" variant="bare" /></div>}
  </div>
  <div class="container legal">
    <p>© {year} Kile Research · {domain}</p>
    <p>{site.tagline}</p>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--space-section); padding-block: var(--space-12) var(--space-8); border-top: 1px solid var(--color-border); }
  .top { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); }
  .home { text-decoration: none; display: inline-flex; min-height: var(--target-min); align-items: center; }
  .social { display: flex; gap: var(--space-1); }
  .icon-link { display: inline-flex; align-items: center; justify-content: center; width: var(--target-min); height: var(--target-min); color: var(--color-text-strong); border-radius: var(--radius-inner); }
  .icon-link:hover { background: var(--color-bg-subtle); color: var(--color-text-strong); }
  .icon-link svg { width: 1.25rem; height: 1.25rem; }
  .cols { display: grid; gap: var(--space-6) var(--space-8); margin-top: var(--space-10); grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr)); }
  .nl { grid-column: 1 / -1; max-width: 26rem; }
  @media (min-width: 64rem) { .cols { grid-template-columns: 1fr 1fr 1fr minmax(0, 22rem); } .nl { grid-column: auto; } }
  nav a, .linklike {
    display: inline-flex; align-items: center; min-height: var(--target-min);
    font-family: var(--font-mono); font-size: 0.8125rem; letter-spacing: var(--tracking-label); text-transform: uppercase;
    color: var(--color-text-strong); text-decoration: none;
  }
  nav a:hover, .linklike:hover { text-decoration: underline; }
  .linklike { background: none; border: 0; padding: 0; cursor: pointer; }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-6); margin-top: var(--space-10); padding-top: var(--space-6); border-top: 1px solid var(--color-border); font-size: var(--text-sm); color: var(--color-text-muted); }
</style>
