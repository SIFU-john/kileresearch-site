---
import { seriesUrl, tagLabel, tagUrl, type Article } from '../lib/content';
interface Props { articles: Article[]; current?: string }
const { articles, current } = Astro.props;
const tags = [...new Set(articles.flatMap((a) => a.data.tags))].sort();
const series = [...new Set(articles.flatMap((a) => (a.data.series ? [a.data.series.name] : [])))];
---
<nav class="filters" aria-label="Filter research">
  <div class="group">
    <h2 class="label">Series</h2>
    <ul class="tags">
      {series.map((s) => <li><a class="tag" href={seriesUrl(s)} aria-current={current === seriesUrl(s) ? 'page' : undefined}>{s}</a></li>)}
    </ul>
  </div>
  <div class="group">
    <h2 class="label">Topics</h2>
    <ul class="tags">
      <li><a class="tag" href="/research/" aria-current={current === undefined ? 'page' : undefined}>All</a></li>
      {tags.map((t) => <li><a class="tag" href={tagUrl(t)} aria-current={current === tagUrl(t) ? 'page' : undefined}>{tagLabel(t)}</a></li>)}
    </ul>
  </div>
</nav>
<style>
  .filters { display: grid; gap: var(--space-4); margin-top: var(--space-8); }
  .label { font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-text-muted); margin-bottom: var(--space-2); letter-spacing: 0; }
  .tag { min-height: var(--target-min); display: inline-flex; align-items: center; padding-inline: var(--space-3); }
</style>
