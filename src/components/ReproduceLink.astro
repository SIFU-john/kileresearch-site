---
import { repoUrl } from '../config/site';
interface Props { repoPath: string }
const { repoPath } = Astro.props;
---
<aside class="reproduce" aria-label="Reproduce this">
  <div>
    <p class="overline">Reproduce this</p>
    <p>Every command and number here was run on our test rig. The code is public so you can check our work.</p>
  </div>
  <a class="btn btn-secondary" href={repoUrl(repoPath)} rel="noopener">View <code>{repoPath}</code> on GitHub</a>
</aside>
<style>
  .reproduce {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4);
    padding: var(--space-5) var(--space-6); border: 1px solid var(--color-border); border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-lg); background: var(--color-bg-accent);
  }
  .reproduce > div { flex: 1 1 20rem; }
  .reproduce code { font-family: var(--font-mono); font-size: 0.85em; }
</style>
