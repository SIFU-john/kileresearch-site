---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<section class:list={['cta', { compact }]} data-surface="ink" aria-labelledby="consulting-cta-title">
  <div class="inner">
    <p class="overline">For small and mid-sized businesses</p>
    <h2 id="consulting-cta-title">Want AI that works, without the risk?</h2>
    <p class="muted">We help SMBs choose, run and measure AI models: practical, private and secure by default.</p>
    <p class="actions">
      <a class="btn btn-primary" href="/consulting/">See how we help</a>
      <a class="btn btn-secondary" href="/contact/">Talk to us</a>
    </p>
  </div>
</section>
<style>
  .cta { border-radius: var(--radius-xl); padding: var(--space-12) var(--space-gutter); box-shadow: var(--shadow-glow); }
  .cta.compact { padding: var(--space-8) var(--space-6); }
  .cta h2 { font-size: var(--text-3xl); margin-block: var(--space-3); }
  .cta.compact h2 { font-size: var(--text-2xl); }
  .inner { max-width: 48rem; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
</style>
