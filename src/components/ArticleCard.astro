---
// Editorial tile: full-bleed cover with a frosted caption (label + title). The title is the
// card's only link (stretched over the whole tile).
import Cover from './Cover.astro';
import { articleUrl, type Article } from '../lib/content';
interface Props { article: Article; headingLevel?: 'h2' | 'h3' }
const { article, headingLevel = 'h3' } = Astro.props;
const { title, series, tags, draft } = article.data;
const H = headingLevel;
const label = series ? `${series.name.replace(/^Beginner's Guide to /, '')} · Part ${series.part}` : tags[0]?.replace(/-/g, ' ') ?? 'Research';
---
<article class="tile">
  <div class="media"><Cover article={article} sizes="(min-width: 64rem) 33vw, 100vw" /></div>
  <div class="glass">
    <p class="overline">{label}{draft && ' · Draft'}</p>
    <H><a class="stretched" href={articleUrl(article)}>{title}</a></H>
  </div>
</article>
