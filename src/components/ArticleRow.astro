---
// Editorial list item: thumbnail left, label / title / description / meta right. The title is
// the only link (stretched); tag links are raised above it.
import Cover from './Cover.astro';
import { articleUrl, formatDate, levelLabel, readingMinutes, tagLabel, tagUrl, type Article } from '../lib/content';
interface Props { article: Article; headingLevel?: 'h2' | 'h3'; showTags?: boolean }
const { article, headingLevel = 'h3', showTags = true } = Astro.props;
const { title, description, date, series, tags, level, draft } = article.data;
const H = headingLevel;
---
<article class="post">
  <div class="media"><Cover article={article} sizes="(min-width: 40rem) 13rem, 100vw" /></div>
  <div class="body">
    <p class="overline">{series ? `${series.name} · Part ${series.part}` : tagLabel(tags[0] ?? 'research')}{draft && ' · Draft'}</p>
    <H><a class="stretched" href={articleUrl(article)}>{title}</a></H>
    <p class="desc">{description}</p>
    <p class="meta-line">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span aria-hidden="true"> · </span>{readingMinutes(article)} min read{level && <> · {levelLabel(level)}</>}
    </p>
    {showTags && (
      <p class="tag-line">
        <span class="visually-hidden">Topics: </span>
        {tags.map((t) => <a class="tag raise" href={tagUrl(t)}>#{tagLabel(t)}</a>)}
      </p>
    )}
  </div>
</article>

<style>
  .tag-line { display: flex; flex-wrap: wrap; gap: 0 var(--space-3); }
  .tag-line .tag { min-height: var(--target-min); }
</style>
