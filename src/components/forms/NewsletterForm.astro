---
// Buttondown newsletter (KILA-42 doc 2 §12). Buttondown's plain HTML embed form, styled with
// our own components: no iframe, no script, email only. Without a configured username the
// panel shows a mailto fallback instead of a form that can't work.
// Variants: "panel" (default, grey card), "bare" (no card; used in the footer).
import { site } from '../../config/site';
import { integrations } from '../../config/integrations';
interface Props { idPrefix?: string; headingLevel?: 'h2' | 'h3'; variant?: 'panel' | 'bare' }
const { idPrefix = 'nl', headingLevel = 'h2', variant = 'panel' } = Astro.props;
const H = headingLevel;
const nl = integrations.newsletter;
---
<section class:list={['newsletter', { 'panel panel-subtle': variant === 'panel', bare: variant === 'bare' }]} aria-labelledby={`${idPrefix}-title`}>
  <H id={`${idPrefix}-title`} class="nl-title">Get new research by email</H>
  <p class="nl-copy">New research, about once a {site.newsletterCadence}. Unsubscribe any time.</p>
  {nl.configured ? (
    <form class="nl-form" method="post" action={nl.action}>
      <input type="hidden" name="embed" value="1" />
      <label class="visually-hidden" for={`${idPrefix}-email`}>Email address</label>
      <input class="input" id={`${idPrefix}-email`} name="email" type="email" autocomplete="email" required maxlength="254" placeholder="name@example.com" />
      <button class="btn btn-primary btn-block" type="submit">Subscribe</button>
      <p class="fine">We only use your email to send you new research. <a href="/privacy/">Privacy notice</a></p>
    </form>
  ) : (
    <div class="nl-off">
      <p>Email sign-up isn't switched on yet.</p>
      <a class="btn btn-primary btn-block" href={`mailto:${site.contactEmail}?subject=${encodeURIComponent('Newsletter sign-up')}`}>Email us to join</a>
      <p class="fine">We'll add you to the list when it launches. <a href="/privacy/">Privacy notice</a></p>
    </div>
  )}
</section>
<style>
  .newsletter { display: grid; gap: var(--space-4); align-content: start; }
  .panel-subtle { padding: var(--space-8) var(--space-6); }
  .nl-title { font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: var(--tracking-label); text-transform: uppercase; font-weight: 400; color: var(--color-text-strong); }
  .nl-copy { color: var(--color-text); }
  .nl-form, .nl-off { display: grid; gap: var(--space-3); }
  .nl-off p:first-child { color: var(--color-text-muted); font-size: var(--text-sm); }
  .fine { font-size: var(--text-sm); color: var(--color-text-muted); }
  .fine a { color: var(--color-text-strong); display: inline-flex; align-items: center; min-height: var(--target-min); }
</style>
