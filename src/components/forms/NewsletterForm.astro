---
// Buttondown newsletter (KILA-42 doc 2 §12). Buttondown's plain HTML embed form, styled with
// our own components: no iframe, no script, email only. Without a configured username the
// panel shows a mailto fallback instead of a form that can't work.
import { site } from '../../config/site';
import { integrations } from '../../config/integrations';
interface Props { idPrefix?: string; headingLevel?: 'h2' | 'h3' }
const { idPrefix = 'nl', headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
const nl = integrations.newsletter;
---
<section class="newsletter panel panel-subtle" aria-labelledby={`${idPrefix}-title`}>
  <H id={`${idPrefix}-title`}>Get new research by email</H>
  <p class="muted">New research, about once a {site.newsletterCadence}. Unsubscribe any time.</p>
  {nl.configured ? (
    <form class="form" method="post" action={nl.action}>
      <input type="hidden" name="embed" value="1" />
      <div class="field">
        <label for={`${idPrefix}-email`}>Email address</label>
        <div class="row">
          <input class="input" id={`${idPrefix}-email`} name="email" type="email" autocomplete="email" required maxlength="254" />
          <button class="btn btn-primary" type="submit">Subscribe</button>
        </div>
      </div>
      <p class="hint"><a href="/privacy/">Privacy notice</a></p>
    </form>
  ) : (
    <div class="alert alert-info">
      <p>Email sign-up isn't switched on yet. <a href={`mailto:${site.contactEmail}?subject=${encodeURIComponent('Newsletter sign-up')}`}>Email us</a> and we'll let you know when it is.</p>
      <p class="hint"><a href="/privacy/">Privacy notice</a></p>
    </div>
  )}
</section>
<style>
  .row { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .row .input { flex: 1 1 14rem; width: auto; }
</style>
