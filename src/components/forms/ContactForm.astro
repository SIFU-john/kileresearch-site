---
import { formConfig } from '../../lib/forms/config';
import { site } from '../../config/site';
const cfg = formConfig('contact');
const id = 'ct';
---
<form
  class="contact-form"
  data-form-kind="contact"
  data-provider={cfg.provider}
  data-endpoint={cfg.endpoint}
  data-mailto={site.contactEmail}
  data-mailto-subject="Enquiry from the Kile Research website"
  method="post"
  action={cfg.endpoint ?? ''}
  aria-describedby={`${id}-privacy`}
>
  <div class="field">
    <label for={`${id}-name`}>Name</label>
    <input class="input" id={`${id}-name`} name="name" autocomplete="name" required maxlength="120" aria-describedby={`${id}-name-error`} />
    <p class="field-error" id={`${id}-name-error`} hidden></p>
  </div>
  <div class="field">
    <label for={`${id}-email`}>Work email</label>
    <input class="input" id={`${id}-email`} name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby={`${id}-email-error`} />
    <p class="field-error" id={`${id}-email-error`} hidden></p>
  </div>
  <div class="field">
    <label for={`${id}-company`}>Company <span class="muted">(optional)</span></label>
    <input class="input" id={`${id}-company`} name="company" autocomplete="organization" maxlength="200" />
  </div>
  <div class="field">
    <label for={`${id}-message`}>How can we help?</label>
    <p class="hint" id={`${id}-message-hint`}>A few lines is plenty. Please don't include passwords, patient or payment data.</p>
    <textarea class="input" id={`${id}-message`} name="message" required minlength="10" maxlength="5000" aria-describedby={`${id}-message-hint ${id}-message-error`}></textarea>
    <p class="field-error" id={`${id}-message-error`} hidden></p>
  </div>
  <div class="hp" aria-hidden="true"><label>Leave empty <input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
  <p class="hint" id={`${id}-privacy`}>We use your details only to reply. See our <a href="/privacy/">privacy notice</a>.</p>
  <p><button class="btn btn-primary" type="submit">Send message</button></p>
  <div class="alert alert-success" data-status="success" tabindex="-1" hidden><p>Thanks, we've got your message and will reply within two working days.</p></div>
  <div class="alert alert-info" data-status="fallback" tabindex="-1" hidden>
    <p>Our contact form isn't connected yet. <a data-mailto-link href={`mailto:${site.contactEmail}`}>Send your message by email instead</a>; we've filled it in for you.</p>
  </div>
  <div class="alert alert-danger" data-status="error" tabindex="-1" hidden>
    <p>Your message didn't send. Please try again, or <a data-mailto-link href={`mailto:${site.contactEmail}`}>email us directly</a>.</p>
  </div>
</form>
<script>
  import '../../lib/forms/client';
</script>
<style>
  .contact-form { display: grid; gap: var(--space-5); max-width: 40rem; }
</style>
