{
  "name": "kile-research-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/write-host-config.mjs",
    "preview": "npm run serve",
    "serve": "node scripts/serve.mjs",
    "check": "astro check",
    "links": "linkinator dist --recurse --skip '^(https?://(?!(localhost|127\\.0\\.0\\.1)[:/])|mailto:)' --verbosity error",
    "links:external": "linkinator dist --recurse --skip 'kile-research\\.example|example\\.com|^mailto:' --retry --verbosity error",
    "lhci": "lhci autorun",
    "fonts": "node scripts/copy-fonts.mjs",
    "verify": "npm run check && npm run build && node scripts/verify-dist.mjs",
    "clean": "rm -rf dist .astro node_modules/.astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.6",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lhci/cli": "0.16.1",
    "@resvg/resvg-js": "2.6.2",
    "linkinator": "8.1.0",
    "pagefind": "1.6.0",
    "satori": "0.63.2",
    "typescript": "6.0.3"
  }
}
